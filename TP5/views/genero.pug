extends layout

block content
  .w3-card-4
    header.w3-container.w3-green
      h2= genero.nome

    .w3-container.w3-padding
      p
        b ID:
        |  #{genero.id}
      p
        b Nº de filmes:
        |  #{genero.filmes ? genero.filmes.length : 0}

      h3 Filmes
      ul.w3-ul.w3-card-4
        if genero.filmes && genero.filmes.length
          each f in genero.filmes
            li
              a(href=`/filmes/${f.id}`)= `${f.title} (${f.year})`
        else
          li Sem filmes

      a.w3-button.w3-grey.w3-margin-top(href='/generos') Voltar
