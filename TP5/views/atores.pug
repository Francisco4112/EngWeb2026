extends layout

block content
  .w3-card-4
    header.w3-container.w3-purple
      h2 Lista de Atores

    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th ID
          th Ator
          th Nº Filmes
        each a in lista
          tr(style='cursor:pointer' onclick=`window.location='/atores/${a.id}'`)
            td= a.id
            td= a.nome
            td= a.filmes ? a.filmes.length : 0
