extends layout

block content
  .w3-card-4
    header.w3-container.w3-indigo
      h2 Lista de Filmes

    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th ID
          th Título
          th Ano
          th #gn
          th #cast
        each f in lista
          tr(style='cursor:pointer' onclick=`window.location='/filmes/${f.id}'`)
            td= f.id
            td= f.title
            td= f.year
            td= f.genres ? f.genres.length : 0
            td= f.cast ? f.cast.length : 0
