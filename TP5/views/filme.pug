extends layout

block content
  .w3-card-4
    header.w3-container.w3-indigo
      h2= filme.title

    .w3-container.w3-padding
      p
        b ID:
        |  #{filme.id}
      p
        b Ano:
        |  #{filme.year}

      h3 Géneros
      ul.w3-ul.w3-card-4
        if filme.genres && filme.genres.length
          each g in filme.genres
            li
              a(href=`/generos/${g.id}`)= g.nome
        else
          li Sem géneros

      h3 Elenco
      ul.w3-ul.w3-card-4
        if filme.cast && filme.cast.length
          each a in filme.cast
            li
              a(href=`/atores/${a.id}`)= a.nome
        else
          li Sem elenco

      a.w3-button.w3-grey.w3-margin-top(href='/filmes') Voltar
