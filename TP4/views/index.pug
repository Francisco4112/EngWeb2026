extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Lista de EMDs
      a.w3-button.w3-small.w3-white.w3-margin-bottom(href='/emd/registo') Novo registo
      a.w3-button.w3-small.w3-dark-grey.w3-margin-left.w3-margin-bottom(href='/emd/stats') Stats
      a.w3-button.w3-small.w3-blue.w3-margin-left.w3-margin-bottom(href='/emd?ord=dataDesc') Ordenar Data desc
      a.w3-button.w3-small.w3-indigo.w3-margin-left.w3-margin-bottom(href='/emd?ord=nomeAsc') Ordenar Nome asc

    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th Nome
          th Data
          th Modalidade
          th Resultado
          th Operações
        each e in lista
          tr(style='cursor:pointer' onclick=`window.location='/emd/${e.id}'`)
            td= e.nome
            td= e.dataEMD
            td= e.modalidade
            td= e.resultado ? 'Apto' : 'Inapto'
            td
              a.w3-button.w3-small.w3-blue(href=`/emd/editar/${e.id}` onclick='event.stopPropagation()') Editar
              a.w3-button.w3-small.w3-red.w3-margin-left(href=`/emd/apagar/${e.id}` onclick='event.stopPropagation()') Apagar
