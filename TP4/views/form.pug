extends layout

block content
  .w3-card-4
    header.w3-container.w3-indigo
      h2= emd ? 'Editar EMD' : 'Novo EMD'

    .w3-container.w3-padding
      form(method='POST' action=emd ? `/emd/${emd.id}` : '/emd')
        if emd
          input(type='hidden' name='id' value=emd.id)
        input(type='hidden' name='index' value=emd ? emd.index : '')

        p
          label Data EMD
          input.w3-input.w3-border(type='date' name='dataEMD' required value=emd ? emd.dataEMD : '')
        p
          label Nome
          input.w3-input.w3-border(type='text' name='nome' required value=emd ? emd.nome : '')
        p
          label Idade
          input.w3-input.w3-border(type='number' name='idade' min='0' required value=emd ? emd.idade : '')
        p
          label Género
          select.w3-select.w3-border(name='género' required)
            option(value='' selected=!emd) Selecione...
            option(value='M' selected=emd && emd.género == 'M') M
            option(value='F' selected=emd && emd.género == 'F') F
        p
          label Morada
          input.w3-input.w3-border(type='text' name='morada' required value=emd ? emd.morada : '')
        p
          label Modalidade
          input.w3-input.w3-border(type='text' name='modalidade' required value=emd ? emd.modalidade : '')
        p
          label Clube
          input.w3-input.w3-border(type='text' name='clube' required value=emd ? emd.clube : '')
        p
          label Email
          input.w3-input.w3-border(type='email' name='email' required value=emd ? emd.email : '')
        p
          label Federado
          select.w3-select.w3-border(name='federado' required)
            option(value='true' selected=emd && emd.federado) Sim
            option(value='false' selected=!emd || !emd.federado) Não
        p
          label Resultado
          select.w3-select.w3-border(name='resultado' required)
            option(value='true' selected=emd && emd.resultado) Apto
            option(value='false' selected=!emd || !emd.resultado) Inapto

        button.w3-button.w3-green(type='submit')= emd ? 'Guardar' : 'Inserir'
        a.w3-button.w3-grey.w3-margin-left(href='/emd') Cancelar
